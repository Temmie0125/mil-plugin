<head>
    <link rel="stylesheet" href="{{_res_path}}html/guess/guess.css">
    <meta charset="utf-8">
</head>

<body style="width: {{style ? imgW : width}}px; height: {{style ? imgH : height}}px;">
    {{if ans}}
    <div class="ans">
        <img src="{{ans}}" alt="答案" style="width: {{imgW}}px; height: {{imgH}}px;">
    </div>
    {{/if}}

    {{if style}}
    <div class="img"
        style="width: {{width}}px;height: {{height}}px;margin-left: {{x}}px;margin-top: {{y}}px;border: 1px solid #888;filter: drop-shadow(0 0 5px #fff);">
        <img src="{{illustration}}" alt="曲绘"
            style="margin-left: -{{x}}px;margin-top: -{{y}}px;width: {{imgW}}px;height: {{imgH}}px;{{@filterStyle || ''}}">
    </div>
    {{else}}
    <div class="img" style="width: {{width}}px;height: {{height}}px;">
        <img src="{{illustration}}" alt="曲绘"
            style="margin-left: -{{x}}px;margin-top: -{{y}}px;width: {{imgW}}px;height: {{imgH}}px;{{@filterStyle || ''}}">
    </div>
    {{/if}}
</body>
