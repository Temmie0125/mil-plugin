{{extend defaultLayout}}

{{block 'css'}}
<link rel="stylesheet" href="{{_res_path}}html/score/score.css">
{{/block}}

{{block 'main'}}
<div class="info-bar">    
    <div class="score-player-info">
            <div class="section-title">Song</div>
            <div style="font-size:22px;font-weight:bold;margin-bottom:4px;" name="pvis">{{songName}}</div>
            <div style="opacity:0.6;">by {{artist}}</div>
            {{if chapter_zh}}
            <div style="opacity:0.4;font-size:13px;margin-top:4px;">{{chapter_zh}}</div>
            {{/if}}
            {{if isRemoved}}
            <div style="color:#ff6b6b;font-size:12px;margin-top:4px;">⚠ 该曲目已从游戏中移除</div>
            {{/if}}
            {{if spinfo}}
            <div style="opacity:0.5;font-size:12px;margin-top:2px;">{{spinfo}}</div>
            {{/if}}
        </div>
    <div class="player-bar">
        <div class="player-avatar">
            <img src="{{_res_path}}avatar/{{avatar}}" alt="avatar">
            {{if starLevel > 0}}
            <img class="star-overlay" src="{{_res_path}}icon/reality{{starLevel}}.png" alt="star">
            {{/if}}
        </div>
        <div class="player-name">
            <p name="pvis">{{username}}</p>
        </div>
        <div class="player-reality">
            <div class="rlt-value">{{reality.toFixed(4)}}</div>
            <div class="rlt-label">Reality</div>
        </div>
    </div>
</div>
<div class="score-container">
    <div class="score-left">
        {{if illustration}}
        <div class="ill-container">
            <div class="ill">
                <img src="{{illustration}}" alt="ill">
            </div>
            <div class="ill ill-background">
                <img src="{{illustration}}" alt="ill">
            </div>
        </div>
        {{/if}}
    </div>

    <div class="score-right">
        {{each scoreData data}}
        <div class="score-dif-card" style="position:relative;">
            {{if data.notPlayed}}
            <div class="score-dif-header">
                <div>
                    <span class="dif-badge dif-{{data.level}}">{{data.levelAbbr || data.level}}</span>
                    <span style="margin-left:8px;opacity:0.5;">{{data.difficulty.toFixed(1)}}</span>
                </div>
            </div>
            <div style="text-align:center;opacity:0.35;padding:10px 0;font-size:18px;">NOT PLAYED</div>
            {{else}}
            <div class="score-dif-header">
                <div>
                    <span class="dif-badge dif-{{data.level}}">{{data.levelAbbr || data.level}}</span>
                    <span style="margin-left:8px;opacity:0.5;">{{data.difficulty.toFixed(1)}}</span>
                </div>
                {{if data.isMultiFinger}}
                <span style="background:#ff9800;color:#fff;font-size:10px;padding:1px 4px;border-radius:3px;margin-left:4px;">多指</span>
                {{/if}}
                {{if data.gradeIcon}}
                <div class="score-grade-badge">
                    <img src="{{_res_path}}icon/{{data.gradeIcon}}.png" alt="{{data.grade}}">
                </div>
                {{/if}}
            </div>
            <div class="score-dif-value">
                {{data.score}}
                {{if data.pushText}}
                <span class="score-push {{data.pushClass}}">>> {{data.pushText}}</span>
                {{/if}}
            </div>
            <div class="score-dif-detail">
                <span>Acc: {{(data.accuracy * 100).toFixed(2)}}%</span>
                <span>Reality: {{data.reality.toFixed(2)}}</span>
                <span>Combo: {{data.combo}}</span>
            </div>
            {{if data.showJudges}}
            <div class="score-judge">
                <span>Exact: {{data.exact}}</span>
                <span>Perfect: {{data.perfect}}</span>
                <span>Great: {{data.great}}</span>
                <span>Good: {{data.good}}</span>
                <span>Bad: {{data.bad}}</span>
                <span>Miss: {{data.miss}}</span>
            </div>
            {{/if}}
            {{if data.played_at}}
            <div style="font-size:12px;opacity:0.4;margin-top:6px;">Played: {{data.played_at}}</div>
            {{/if}}
            {{/if}}
        </div>
        {{/each}}

        {{if !scoreData || scoreData.length == 0}}
        <div class="score-dif-card">
            <div style="text-align:center;opacity:0.5;padding:30px;">暂无该曲目的成绩记录</div>
        </div>
        {{/if}}
    </div>
</div>

<div class="createdbox">
    <div class="mil-plugin">
        <p>mil-plugin</p>
    </div>
    <div class="ver">
        <p>{{version}}</p>
    </div>
</div>

{{/block}}
